#usda 1.0
(
    doc = "STS lower side beams, widened column shoes, 8 rail wheels per side. Visual geometry follows Gantry."
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def "STSRunningGearLooks"
    {
        def Material "BlueSteel"
        {
            token outputs:surface.connect = </World/STSRunningGearLooks/BlueSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.3, 0.4)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "RailWheelSteel"
        {
            token outputs:surface.connect = </World/STSRunningGearLooks/RailWheelSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.045, 0.05)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.34
                token outputs:surface
            }
        }

        def Material "MachinedSteel"
        {
            token outputs:surface.connect = </World/STSRunningGearLooks/MachinedSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.32, 0.34)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }

    def "STSControls"
    {
        def "STS_01"
        {
            def "Gantry"
            {
                over "Fixed"
