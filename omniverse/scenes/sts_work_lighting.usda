def "World"
{
    def "STSWorkLightingLooks"
    {
        def Material "Housing"
        {
            token outputs:surface.connect = </World/STSWorkLightingLooks/Housing/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.06, 0.07, 0.08)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "Lens"
        {
            token outputs:surface.connect = </World/STSWorkLightingLooks/Lens/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.95, 1)
                color3f inputs:emissiveColor = (12, 13, 14)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

