#usda 1.0
(
    defaultPrim = "CustomFeederShip"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "CustomFeederShip" (
    prepend references = @../assets/ship/Custom_Feeder_Ship.usdc@</CustomFeederShip>
)
{
    def "PortFinish"
    {
        def Material "Hull"
        {
            token outputs:surface.connect = </CustomFeederShip/PortFinish/Hull/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.019, 0.022, 0.021)
                color3f inputs:diffuseColor.connect = </CustomFeederShip/PortFinish/Hull/Color.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.78
                token outputs:surface
            }

            def Shader "ColorUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "portHullUV"
                float2 outputs:result
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../materials/textures/port_hull_finish.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </CustomFeederShip/PortFinish/Hull/ColorUV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "clamp"
                float outputs:a
                float3 outputs:rgb
            }
        }
    }

    over "Model"
    {
        over "CODEx_left_reference_feeder_ship_clone_stern_enclosure_stern_st"
