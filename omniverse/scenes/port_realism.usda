#usda 1.0
(
    doc = "Visual surfacing only. Rebuild with build_port_realism.py; remove this sublayer to revert."
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def Xform "PortRealism"
    {
        def "Looks"
        {
            def Material "asphalt"
            {
                token outputs:surface.connect = </World/PortRealism/Looks/asphalt/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.06, 0.065, 0.06)
                    color3f inputs:diffuseColor.connect = </World/PortRealism/Looks/asphalt/color.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/PortRealism/Looks/asphalt/normal.outputs:rgb>
                    float inputs:roughness = 0.8
                    float inputs:roughness.connect = </World/PortRealism/Looks/asphalt/roughness.outputs:r>
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "color"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @../materials/textures/port_asphalt_color.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/PortRealism/Looks/asphalt/UV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @../materials/textures/port_asphalt_normal.png@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/PortRealism/Looks/asphalt/UV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @../materials/textures/port_asphalt_roughness.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/PortRealism/Looks/asphalt/UV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }
            }

            def Material "concrete"
            {
                token outputs:surface.connect = </World/PortRealism/Looks/concrete/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.2, 0.19, 0.17)
                    color3f inputs:diffuseColor.connect = </World/PortRealism/Looks/concrete/color.outputs:rgb>
