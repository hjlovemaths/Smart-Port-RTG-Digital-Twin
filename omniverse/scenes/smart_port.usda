def Xform "World"
{
    def Scope "ShipDouble20Materials"
    {
        def Material "Double20Orange"
        {
            token outputs:surface.connect = </World/ShipDouble20Materials/Double20Orange/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.11, 0.055)
                float inputs:roughness = 0.76
                token outputs:surface
            }
        }

        def Material "Double20Cyan"
        {
            token outputs:surface.connect = </World/ShipDouble20Materials/Double20Cyan/Shader.outputs:surface>

