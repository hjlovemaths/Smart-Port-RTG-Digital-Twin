#usda 1.0
(
    doc = "Visual water, shared ship material wrapper and sparse road wear. No motion/physics edits."
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def Xform "PortFinishRealism"
    {
        custom string[] finishedShips = ["/World/PortAndRTG/SMART_PORT_4C_FEEDER_SHIP_LEFT_IMPORTED", "/World/PortAndRTG/SMART_PORT_4C_FEEDER_SHIP_RIGHT_IMPORTED", "/World/PortAndRTG/SMART_PORT_LOCAL_SHIP_4c40_shoreline_east_IMPORTED", "/World/PortAndRTG/SMART_PORT_LOCAL_SHIP_4c40_shoreline_west_IMPORTED", "/World/PortAndRTG/SMART_PORT_REMOTE_CARGO_SHIP_01", "/World/PortAndRTG/SMART_PORT_REMOTE_CARGO_SHIP_02"]

        def "Looks"
        {
            def Material "TireWear"
            {
                token outputs:surface.connect = </World/PortFinishRealism/Looks/TireWear/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.045, 0.047, 0.045)
                    color3f inputs:diffuseColor.connect = </World/PortFinishRealism/Looks/TireWear/Texture.outputs:rgb>
                    float inputs:metallic = 0
                    float inputs:roughness = 0.86
                    token outputs:surface
                }

                def Shader "TextureUV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Texture"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @../materials/textures/port_tire_wear.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/PortFinishRealism/Looks/TireWear/TextureUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "clamp"
                    float outputs:a
                    float3 outputs:rgb
                }
            }

            def Material "AsphaltRepair"
            {
                token outputs:surface.connect = </World/PortFinishRealism/Looks/AsphaltRepair/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.036, 0.038, 0.036)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.96
                    token outputs:surface
                }
            }

            def Material "RepairEdge"
            {
                token outputs:surface.connect = </World/PortFinishRealism/Looks/RepairEdge/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.025, 0.027, 0.025)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.96
                    token outputs:surface
                }
            }
        }

