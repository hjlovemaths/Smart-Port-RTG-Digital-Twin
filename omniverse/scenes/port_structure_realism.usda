#usda 1.0
(
    doc = "Visual coastal structures and equipment finishes. No physics, inventory or control transforms."
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def Xform "PortStructureRealism"
    {
        custom int adjustedShaderCount = 77
        custom double seaLevel = -4.9478

        def "Looks"
        {
            def Material "MarineConcrete"
            {
                token outputs:surface.connect = </World/PortStructureRealism/Looks/MarineConcrete/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.94, 0.96, 0.95)
                    color3f inputs:diffuseColor.connect = </World/PortStructureRealism/Looks/MarineConcrete/Texture.outputs:rgb>
                    float inputs:metallic = 0
                    float inputs:roughness = 0.9
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Texture"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @../materials/textures/port_concrete_color.png@
                    float4 inputs:scale = (0.94, 0.96, 0.95, 1)
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/PortStructureRealism/Looks/MarineConcrete/UV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "CopingConcrete"
            {
                token outputs:surface.connect = </World/PortStructureRealism/Looks/CopingConcrete/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1.1, 1.1, 1.04)
                    color3f inputs:diffuseColor.connect = </World/PortStructureRealism/Looks/CopingConcrete/Texture.outputs:rgb>
                    float inputs:metallic = 0
                    float inputs:roughness = 0.9
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Texture"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @../materials/textures/port_concrete_color.png@
                    float4 inputs:scale = (1.1, 1.1, 1.04, 1)
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/PortStructureRealism/Looks/CopingConcrete/UV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float3 outputs:rgb
                }
            }

            def Material "WetTidalConcrete"
            {
                token outputs:surface.connect = </World/PortStructureRealism/Looks/WetTidalConcrete/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.11, 0.12, 0.09)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.93
                    token outputs:surface
                }
            }

            def Material "ExpansionJoint"
            {
                token outputs:surface.connect = </World/PortStructureRealism/Looks/ExpansionJoint/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.04, 0.037, 0.03)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.98
                    token outputs:surface
                }
            }

            def Material "RunoffStain"
            {
                token outputs:surface.connect = </World/PortStructureRealism/Looks/RunoffStain/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.16, 0.135, 0.105)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.98
                    token outputs:surface
                }
            }

            def Material "FenderRubber"
            {
                token outputs:surface.connect = </World/PortStructureRealism/Looks/FenderRubber/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.014, 0.017, 0.019)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.93
                    token outputs:surface
                }
            }

            def Material "WeatheredGalvanizedSteel"
            {
                token outputs:surface.connect = </World/PortStructureRealism/Looks/WeatheredGalvanizedSteel/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.32, 0.34, 0.33)
                    float inputs:metallic = 0.72
                    float inputs:roughness = 0.48
                    token outputs:surface
                }
            }
        }

