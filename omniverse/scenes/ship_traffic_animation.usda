#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 925
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "SMART_PORT_OUTBOUND_CARGO_SHIP" (
        prepend references = @../assets/ship/Custom_Feeder_Ship.usdc@</CustomFeederShip>
    )
    {
        custom string ship:motion = "outbound to open sea"
        custom double ship:routeLengthMeters = 1034.8689930820296
        token visibility = "inherited"
        token visibility.timeSamples = {
            720: "inherited",
            900: "invisible",
        }
        float xformOp:rotateZ = 165
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-350, 570, -7.5)
        double3 xformOp:translate.timeSamples = {
            1: (-350, 570, -7.5),
            240: (-600, 650, -7.5),
            480: (-900, 760, -7.5),
            720: (-1260, 900, -7.5),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
    }
}
