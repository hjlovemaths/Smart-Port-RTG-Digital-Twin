#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 925
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "SMART_PORT_OUTBOUND_CARGO_SHIP" (
        prepend references = @../assets/resource/ship/Cargo_Ship_09_variant_b.usdz@
    )
    {
        custom string ship:motion = "outbound to open sea"
        custom double ship:routeLengthMeters = 1034.8689930820296
        token visibility = "inherited"
        token visibility.timeSamples = {
            720: "inherited",
            900: "invisible",
        }
        float xformOp:rotateX = 90
        float xformOp:rotateZ = 165
        float3 xformOp:scale = (0.03883929, 0.027641999, 0.043764994)
        double3 xformOp:translate.timeSamples = {
            1: (-260, 495, 1.3012471449582028),
            240: (-520, 555, 1.3012471449582028),
            480: (-820, 630, 1.3012471449582028),
            720: (-1260, 760, 1.3012471449582028),
        }
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:rotateX", "xformOp:scale"]
    }
}
