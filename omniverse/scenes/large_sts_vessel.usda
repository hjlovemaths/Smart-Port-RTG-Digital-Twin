#usda 1.0
(
    defaultPrim = "World"
    doc = "Single STS01-03 vessel. Layout follows supplied bay/row/tier diagrams; dimensions are project design values, not TOS measurements."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "PortAndRTG"
    {
        over "SMART_PORT_4C_FEEDER_SHIP_LEFT_IMPORTED" (
            active = false
        )
        {
        }

