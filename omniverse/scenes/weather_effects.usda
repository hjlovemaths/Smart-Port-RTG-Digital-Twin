#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

over Xform "World"
{
    def Xform "SMART_PORT_WEATHER"
    {
        custom string smartPort:description = "Four strongly separated rain densities with wet-road sheen and torrential near-screen streaks"
        custom string smartPort:rainAmountScale = "Light <10 mm/24h; Moderate 10-25 mm/24h; Heavy 25-50 mm/24h; Torrential 50-100 mm/24h plus short burst >16 mm/h"
        custom string smartPort:rainAmountBehavior = "Each rain amount combines cumulative drop count, streak length, streak width, fall speed, opacity, and emission; ground splashes and puddles are disabled"

        def Scope "Looks"
        {
            def Material "RainStreakMaterial"
            {
                token outputs:surface.connect = </World/SMART_PORT_WEATHER/Looks/RainStreakMaterial/PreviewSurface.outputs:surface>
                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.58, 0.62, 0.65)
                    color3f inputs:emissiveColor = (0.008, 0.008, 0.008)
                    float inputs:metallic = 0
                    float inputs:opacity = 0.32
                    float inputs:roughness = 0.18
                    token outputs:surface
                }
            }

            def Material "WetRoadMaterial"
            {
                token outputs:surface.connect = </World/SMART_PORT_WEATHER/Looks/WetRoadMaterial/PreviewSurface.outputs:surface>
                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.07, 0.11, 0.14)
                    float inputs:metallic = 0.35
                    float inputs:opacity = 0.12
                    float inputs:roughness = 0.08
                    token outputs:surface
                }
            }

            def Material "AtmosphereOverlayMaterial"
            {
                token outputs:surface.connect = </World/SMART_PORT_WEATHER/Looks/AtmosphereOverlayMaterial/PreviewSurface.outputs:surface>
                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.52, 0.58, 0.61)
                    color3f inputs:emissiveColor = (0.10, 0.12, 0.13)
                    float inputs:metallic = 0
                    float inputs:opacity = 0
                    float inputs:roughness = 1
                    token outputs:surface
                }
            }

        }

        def Xform "Rain"
        {
            token visibility = "invisible"
            custom int smartPort:rainDropCount = 2000
            custom string smartPort:rainLayerDropCounts = "Light=100; Moderate=350 cumulative; Heavy=850 cumulative; Torrential=2000 cumulative"
            custom string smartPort:performance = "Camera-local air rain only; puddles, splashes, and impact mist are disabled"
            custom string smartPort:animationDriver = "smartport.rtg_bridge update loop"
            custom string smartPort:groundClampRule = "Each grade uses three phase-shifted emitter batches that reset before their longest streak crosses Z=0.55 m, leaving a visible gap above the road"

            def Xform "AirRain"
            {
                custom string smartPort:followRule = "Air rain follows the active camera in XY"
            def Xform "RainLayer01"
            {
                custom int smartPort:dropCount = 100
                custom string smartPort:streakLengthMeters = "0.18-0.38"
                custom int smartPort:phaseCount = 3
                def Mesh "Phase01"
                {
                    custom int smartPort:dropCount = 34
                    uniform bool doubleSided = true
                    rel material:binding = </World/SMART_PORT_WEATHER/Looks/RainStreakMaterial>
                    uniform token orientation = "rightHanded"
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
