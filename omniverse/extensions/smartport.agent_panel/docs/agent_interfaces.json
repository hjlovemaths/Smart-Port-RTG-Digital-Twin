    {
      "type": "function",
      "function": {
        "name": "preview_yard_to_ship_transfer",
        "description": "Read-only plan for a reversible RTG -> truck -> STS loading demo. Resolve actual SOURCE box size, never guess it from yard bay parity; returns size_ft and spreader_adjustment (current size, target, required). Specify source yard bay/row and optional tier (defaults to highest visible box), plus exact six-digit ship target location, e.g. 011090. Rejects buried source/target, absent 6.6 deck cells, unsupported landing, wrong size, uneven 40ft supports and unreachable STS. 20ft uses odd ship bays; 40ft uses an even bay spanning two returned odd bays. Target structural placeholders are replaced only in the demo layer, not verified vacant actual cargo slots. Returns plan_id before start.",
        "parameters": {
          "type": "object",
          "properties": {
            "source_bay": {
              "type": "string",
              "description": "For example 4C41 or 4C/041"
            },
            "source_row": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "source_tier": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "target_location": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "crane_id": {
              "type": "string",
              "description": "STS_01 through STS_07; specify the requested crane"
            }
          },
          "required": [
            "source_bay",
            "source_row",
            "target_location"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "start_yard_to_ship_transfer",
        "description": "Start a previewed yard-to-vessel loading demo by plan_id after scene-operation approval. FIRST read current RTG spreader and continuously telescope to the source box size; no descent or locking until actual geometry confirms ready. Then parked truck drives to yard; RTG locks/lifts source onto trailer; truck follows roads and causeway to selected STS; STS locks/lifts/transfers/unlocks at specified ship location. Full original box parts move continuously without rescaling. No inventory-file or PLC writes. Returns immediately; status includes rtg_spreader_size_ft, required_size_ft and spreader_ready. Poll control_yard_to_ship_transfer once and report started if still running.",
        "parameters": {
          "type": "object",
          "properties": {
            "plan_id": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "plan_id"
          ],
          "additionalProperties": false
        }
      }
    },
